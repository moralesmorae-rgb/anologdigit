<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title></title>
    <style>
        /* --- ESTILOS GENERALES --- */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #121212;
            color: #e0e0e0;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* ENCABEZADO */
        header {
            background-color: #000000;
            width: 100%;
            padding: 20px 0;
            text-align: center;
            border-bottom: 3px solid #ffcc00;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            min-height: 40px;
        }

        /* CONTENEDOR PRINCIPAL */
        .container {
            width: 90%;
            max-width: 800px;
            background-color: #1e1e1e;
            padding: 40px;
            border-radius: 12px;
            border-top: 5px solid #ffcc00;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            margin-top: 120px; 
            margin-bottom: 80px;
            line-height: 1.6;
            text-align: left;
        }

        ul { margin-bottom: 20px; padding-left: 20px; }
        li { margin-bottom: 8px; }

        /* --- ESTILOS DEL INTERACTIVO --- */
        .herramienta-interactiva {
            background-color: #2a2a2a;
            border: 2px dashed #ffcc00;
            border-radius: 10px;
            padding: 25px;
            margin: 25px 0;
            text-align: center;
            box-shadow: inset 0 0 15px rgba(0,0,0,0.5);
        }

        /* Gráfico de la Resistencia */
        .resistencia-grafico {
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 20px auto;
            position: relative;
            width: 250px;
            height: 60px;
            background-color: #e5c39c; 
            border-radius: 30px;
            border: 2px solid #8c6a45;
        }

        .resistencia-grafico::before, .resistencia-grafico::after {
            content: '';
            position: absolute;
            width: 60px;
            height: 8px;
            background-color: #999;
            z-index: -1;
        }
        .resistencia-grafico::before { left: -60px; }
        .resistencia-grafico::after { right: -60px; }

        .banda {
            width: 15px;
            height: 100%;
            margin: 0 10px;
            transition: background-color 0.2s ease;
        }

        .controles-flex {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 15px;
        }

        select, input[type="number"] {
            padding: 10px;
            border-radius: 5px;
            border: 1px solid #ffcc00;
            background-color: #121212;
            color: #fff;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
            min-width: 60px;
            min-height: 40px;
        }

        input[type="number"] {
            width: 100px;
            text-align: center;
        }

        .resultado-destacado {
            font-size: 1.5rem;
            font-weight: bold;
            font-family: monospace;
            background: #000;
            padding: 10px 20px;
            border-radius: 5px;
            color: #00ff00;
            border: 1px solid #333;
            display: inline-block;
            margin-top: 15px;
            min-width: 100px;
            min-height: 25px;
        }

        /* --- ESTILOS PARA CAJAS GALERÍA --- */
        .galeria-duo {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;
            margin: 30px 0;
            flex-wrap: wrap;
            width: 100%;
        }

        /* --- ESTILOS VISUALIZACIÓN EN SERIE --- */
        .circuito-serie-visual {
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 30px auto;
            width: 100%;
            max-width: 500px;
            background: #1a1a1a;
            padding: 20px;
            border-radius: 8px;
            border: 1px solid #333;
            box-sizing: border-box;
        }

        .cable {
            flex-grow: 1;
            height: 4px;
            background-color: #666;
        }

        .resistor-bloque {
            width: 80px;
            height: 35px;
            background-color: #e5c39c;
            border: 2px solid #8c6a45;
            border-radius: 6px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #000;
            font-weight: bold;
            font-size: 0.85rem;
        }

        .formula-destacada {
            background-color: #141414;
            padding: 15px;
            border-left: 4px solid #ffcc00;
            margin: 20px 0;
            min-height: 20px;
        }

        /* --- ESTILOS VISUALIZACIÓN EN PARALELO --- */
        .circuito-paralelo-visual {
            display: flex;
            flex-direction: column;
            gap: 15px;
            background: #1a1a1a;
            padding: 25px;
            border-radius: 8px;
            border: 1px solid #333;
            max-width: 420px;
            margin: 30px auto;
            position: relative;
        }

        .circuito-paralelo-visual::before {
            content: '';
            position: absolute;
            top: 35px;
            bottom: 35px;
            left: 50px;
            width: 4px;
            background-color: #666;
        }

        .circuito-paralelo-visual::after {
            content: '';
            position: absolute;
            top: 35px;
            bottom: 35px;
            right: 50px;
            width: 4px;
            background-color: #666;
        }

        .paralelo-rama {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            padding: 0 30px;
            box-sizing: border-box;
        }

        .cable-p-left {
            flex-grow: 1;
            height: 4px;
            background-color: #666;
            margin-right: 10px;
        }

        .cable-p-right {
            flex-grow: 1;
            height: 4px;
            background-color: #666;
            margin-left: 10px;
        }

        .nodo-conexion {
            width: 12px;
            height: 12px;
            background-color: #ffcc00;
            border-radius: 50%;
            z-index: 2;
        }
    </style>
</head>
<body>

    <!-- ENCABEZADO -->
    <header></header>

    <!-- CONTENEDOR PRINCIPAL -->
    <main class="container">

        <!-- CALCULADORA INTERACTIVA -->
        <div class="herramienta-interactiva" id="calculadora-colores">
            <div class="resistencia-grafico">
                <div class="banda" id="visual-b1"></div>
                <div class="banda" id="visual-b2"></div>
                <div class="banda" id="visual-b3"></div>
                <div class="banda" id="visual-b4" style="margin-left: 30px;"></div>
            </div>

            <div class="controles-flex">
                <select id="sel-b1"></select>
                <select id="sel-b2"></select>
                <select id="sel-b3"></select>
                <select id="sel-b4"></select>
            </div>
            <div class="resultado-destacado" id="res-colores"></div>
        </div>

        <div class="galeria-duo"></div>

        <div class="formula-destacada"></div>

        <!-- INTERACTIVO CIRCUITO EN SERIE -->
        <div class="herramienta-interactiva" id="interactivo-serie">
            <div class="circuito-serie-visual">
                <div class="cable"></div>
                <div class="resistor-bloque" id="v-r1"></div>
                <div class="cable"></div>
                <div class="resistor-bloque" id="v-r2"></div>
                <div class="cable"></div>
                <div class="resistor-bloque" id="v-r3"></div>
                <div class="cable"></div>
            </div>

            <div class="controles-flex">
                <div>
                    <input type="number" id="num-r1" min="0" max="999999">
                </div>
                <div>
                    <input type="number" id="num-r2" min="0" max="999999">
                </div>
                <div>
                    <input type="number" id="num-r3" min="0" max="999999">
                </div>
            </div>
            
            <div class="resultado-destacado" id="res-serie"></div>
        </div>

        <div class="formula-destacada"></div>

        <!-- INTERACTIVO CIRCUITO EN PARALELO -->
        <div class="herramienta-interactiva" id="interactivo-paralelo">
            <div class="circuito-paralelo-visual">
                <div class="paralelo-rama">
                    <div class="nodo-conexion"></div>
                    <div class="cable-p-left"></div>
                    <div class="resistor-bloque" id="vp-r1"></div>
                    <div class="cable-p-right"></div>
                    <div class="nodo-conexion"></div>
                </div>
                <div class="paralelo-rama">
                    <div class="nodo-conexion"></div>
                    <div class="cable-p-left"></div>
                    <div class="resistor-bloque" id="vp-r2"></div>
                    <div class="cable-p-right"></div>
                    <div class="nodo-conexion"></div>
                </div>
                <div class="paralelo-rama">
                    <div class="nodo-conexion"></div>
                    <div class="cable-p-left"></div>
                    <div class="resistor-bloque" id="vp-r3"></div>
                    <div class="cable-p-right"></div>
                    <div class="nodo-conexion"></div>
                </div>
            </div>

            <div class="controles-flex">
                <div>
                    <input type="number" id="num-p1" min="0" max="999999">
                </div>
                <div>
                    <input type="number" id="num-p2" min="0" max="999999">
                </div>
                <div>
                    <input type="number" id="num-p3" min="0" max="999999">
                </div>
            </div>
            <div class="resultado-destacado" id="res-paralelo"></div>
        </div>

    </main>

</body>
</html>
